# Copy to .env (gitignored). Every script reads these; a variable set in the environment wins over this file.
# Check what the scripts will use with: npm run tv -- --dev --config

# From the Developer Mode app on the TV (Key Server must be ON to pair). Used by npm run tv / tv:dev.
TV_IP=
TV_PASSPHRASE=

# Optional
# WEBOS_DEVICE=tv        # name the TV is registered under (ares-setup-device); set it to target another TV
# DEV_PORT=5500          # port for the tv:dev server
# HOST_IP=192.168.1.20   # this machine's address as the TV sees it; detected automatically when empty
# WEBOS_DEV=1            # make shot/eval/key/logs/inspect/close/uninstall act on the tv:dev app (<id>.dev)
# CDP_TIMEOUT_MS=30000   # how long shot/eval/key/logs wait for each DevTools command
