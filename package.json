{
  "name": "starter-webos-tv-app",
  "private": true,
  "description": "Starter template for LG webOS TV web apps",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tv": "bash scripts/tv-up.sh",
    "tv:dev": "bash scripts/tv-up.sh --dev",
    "dev": "bash scripts/tv-up.sh --dev",
    "setup:cli": "bash scripts/install-cli.sh",
    "pair": "bash scripts/pair-tv.sh",
    "doctor": "bash scripts/doctor.sh",
    "new": "node scripts/create-app.mjs",
    "deploy": "bash scripts/deploy.sh",
    "package": "bash scripts/tv.sh package",
    "install-tv": "bash scripts/tv.sh install",
    "launch": "bash scripts/tv.sh launch",
    "close": "bash scripts/tv.sh close",
    "inspect": "bash scripts/tv.sh inspect",
    "shot": "node scripts/cdp.mjs shot",
    "eval": "node scripts/cdp.mjs eval",
    "key": "node scripts/cdp.mjs key",
    "logs": "node scripts/cdp.mjs logs",
    "uninstall": "bash scripts/tv.sh uninstall",
    "list": "bash scripts/tv.sh list",
    "tv-info": "bash scripts/tv.sh info",
    "sim": "bash scripts/tv.sh sim",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
